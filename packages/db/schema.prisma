// Câmara 360º — modelo de dados inicial (rascunho do MVP)
// Todo registro relevante carrega camaraId (multi-tenant), autoria, datas e trilha de auditoria.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Núcleo institucional ─────────────
model Camara {
  id            String   @id @default(uuid())
  nome          String
  municipio     String
  uf            String   @db.Char(2)
  codigoIbge    String   @unique
  cnpj          String   @unique
  criadoEm      DateTime @default(now())
  legislaturas  Legislatura[]
  parlamentares Parlamentar[]
  usuarios      Usuario[]
  especies      EspecieNormativa[]
  proposicoes   Proposicao[]
  comissoes     Comissao[]
  sessoes       Sessao[]
  demandas      Demanda[]
  alertas       Alerta[]
  configuracao  ConfiguracaoRegimental?
}

model ConfiguracaoRegimental {
  id                  String  @id @default(uuid())
  camaraId            String  @unique
  camara              Camara  @relation(fields: [camaraId], references: [id])
  totalCadeiras       Int
  leiOrganicaUrl      String?
  regimentoUrl        String?
  modoPeriodoEleitoral Boolean @default(false)
  regras              Json    // parâmetros gerais (interstícios, prazos padrão etc.)
}

model Legislatura {
  id         String   @id @default(uuid())
  camaraId   String
  camara     Camara   @relation(fields: [camaraId], references: [id])
  numero     Int
  inicio     DateTime
  fim        DateTime
  mandatos   Mandato[]
}

model Parlamentar {
  id          String    @id @default(uuid())
  camaraId    String
  camara      Camara    @relation(fields: [camaraId], references: [id])
  nomeParlamentar String
  nomeCivil   String
  partido     String?
  mandatos    Mandato[]
  gabinete    Gabinete?
  autorias    Autoria[]
  votos       Voto[]
}

model Mandato {
  id            String      @id @default(uuid())
  parlamentarId String
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  legislaturaId String
  legislatura   Legislatura @relation(fields: [legislaturaId], references: [id])
  condicao      String      // titular, suplente em exercício, licenciado
  inicio        DateTime
  fim           DateTime?
}

model Gabinete {
  id            String      @id @default(uuid())
  parlamentarId String      @unique
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  demandas      Demanda[]
}

model Usuario {
  id        String   @id @default(uuid())
  camaraId  String
  camara    Camara   @relation(fields: [camaraId], references: [id])
  nome      String
  email     String
  mfaAtivo  Boolean  @default(false)
  papeis    String[] // presidente, vereador, assessor, servidor, procurador, cidadão...
  @@unique([camaraId, email])
}

model Auditoria {
  id         BigInt   @id @default(autoincrement())
  camaraId   String
  usuarioId  String?
  entidade   String
  entidadeId String
  acao       String   // criar, alterar, assinar, publicar, revisar_ia...
  antes      Json?
  depois     Json?
  origemIa   Boolean  @default(false)
  ip         String?
  em         DateTime @default(now())
  @@index([camaraId, entidade, entidadeId])
}

// ───────────── Processo legislativo (motor de ritos) ─────────────
model EspecieNormativa {
  id          String   @id @default(uuid())
  camaraId    String
  camara      Camara   @relation(fields: [camaraId], references: [id])
  sigla       String   // PLO, PLC, PR, PDL, PELO, IND, REQ, MOC
  nome        String
  quorum      String   // simples | absoluta | dois_tercos
  turnos      Int      @default(1)
  iniciativaReservada String[] // ex.: ["prefeito"]
  fluxo       Json     // máquina de estados: estados, transições e guardas parametrizadas
  proposicoes Proposicao[]
  @@unique([camaraId, sigla])
}

model Proposicao {
  id          String   @id @default(uuid())
  camaraId    String
  camara      Camara   @relation(fields: [camaraId], references: [id])
  especieId   String
  especie     EspecieNormativa @relation(fields: [especieId], references: [id])
  numero      Int
  ano         Int
  ementa      String
  estado      String
  regime      String   @default("ordinario")
  protocoladaEm DateTime?
  prazoFinal  DateTime?
  autorias    Autoria[]
  versoes     VersaoDocumento[]
  movimentos  Movimentacao[]
  demandas    DemandaProposicao[]
  @@unique([camaraId, especieId, numero, ano])
}

model Autoria {
  proposicaoId  String
  proposicao    Proposicao  @relation(fields: [proposicaoId], references: [id])
  parlamentarId String
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  principal     Boolean     @default(true)
  @@id([proposicaoId, parlamentarId])
}

model VersaoDocumento {
  id           String   @id @default(uuid())
  proposicaoId String
  proposicao   Proposicao @relation(fields: [proposicaoId], references: [id])
  versao       Int
  conteudo     String
  hashSha256   String
  geradoPorIa  Boolean  @default(false)
  revisadoPor  String?
  assinaturas  Json?
  criadoEm     DateTime @default(now())
}

model Movimentacao {
  id           String   @id @default(uuid())
  proposicaoId String
  proposicao   Proposicao @relation(fields: [proposicaoId], references: [id])
  de           String
  para         String
  descricao    String
  responsavel  String
  em           DateTime @default(now())
}

model Comissao {
  id        String  @id @default(uuid())
  camaraId  String
  camara    Camara  @relation(fields: [camaraId], references: [id])
  nome      String
  sigla     String
  permanente Boolean @default(true)
}

// ───────────── Plenário ─────────────
model Sessao {
  id        String   @id @default(uuid())
  camaraId  String
  camara    Camara   @relation(fields: [camaraId], references: [id])
  tipo      String   // ordinária, extraordinária, solene, especial
  numero    Int
  data      DateTime
  pauta     Json
  presencas Json
  votacoes  Votacao[]
  ataStatus String   @default("rascunho") // rascunho | minuta_ia | revisada | aprovada | assinada
}

model Votacao {
  id           String  @id @default(uuid())
  sessaoId     String
  sessao       Sessao  @relation(fields: [sessaoId], references: [id])
  proposicaoId String
  modalidade   String  // nominal, simbólica
  resultado    String?
  votos        Voto[]
}

model Voto {
  votacaoId     String
  votacao       Votacao     @relation(fields: [votacaoId], references: [id])
  parlamentarId String
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  valor         String      // sim, não, abstenção
  @@id([votacaoId, parlamentarId])
}

// ───────────── Cidadão e demandas ─────────────
model Demanda {
  id          String   @id @default(uuid())
  camaraId    String
  camara      Camara   @relation(fields: [camaraId], references: [id])
  protocolo   String
  assunto     String
  descricao   String
  bairro      String?
  latitude    Float?
  longitude   Float?
  fotos       String[]
  status      String   @default("recebida") // recebida, analise, encaminhada, respondida, concluida
  gravidade   Int?
  gabineteId  String?
  gabinete    Gabinete? @relation(fields: [gabineteId], references: [id])
  // Dados pessoais do solicitante ficam em tabela separada, com acesso restrito (LGPD)
  solicitanteRef String?
  criadaEm    DateTime @default(now())
  proposicoes DemandaProposicao[]
  @@unique([camaraId, protocolo])
}

model DemandaProposicao {
  demandaId    String
  demanda      Demanda    @relation(fields: [demandaId], references: [id])
  proposicaoId String
  proposicao   Proposicao @relation(fields: [proposicaoId], references: [id])
  @@id([demandaId, proposicaoId])
}

// ───────────── Fiscalização ─────────────
model FonteDados {
  id        String @id @default(uuid())
  nome      String // SIM/TCE-CE, PNCP, Portal da Transparência…
  url       String?
  ultimaCarga DateTime?
}

model Alerta {
  id          String   @id @default(uuid())
  camaraId    String
  camara      Camara   @relation(fields: [camaraId], references: [id])
  area        String   // saude, educacao, obras, pessoal, licitacoes, patrimonio, orcamento, transferencias
  nivel       String   // alerta | inconsistencia | indicio | conclusao_formal
  titulo      String
  regra       String
  calculo     Json     // consulta e parâmetros reproduzíveis
  evidencias  Json     // fontes, datas de extração, documentos
  status      String   @default("aberto")
  criadoEm    DateTime @default(now())
}
